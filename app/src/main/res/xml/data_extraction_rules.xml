<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device. API keys are wrapped by a hardware-backed Keystore
  key that is itself non-exportable, so a backup would be useless anyway, but
  excluding everything makes the intent explicit and prevents cloud backup or
  device-to-device transfer from carrying encrypted credential blobs around.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
